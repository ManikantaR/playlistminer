{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Quartz": {
    "SyncCron": "0 0 2 * * ?",
    "InboxCron": "0 0 */6 * * ?",
    "CategorizationCron": "0 30 2 * * ?",
    "CleanupCron": "0 0 3 * * ?",
    "BackupCron": "0 0 4 * * ?"
  },
  "Backup": {
    "Directory": "./data/backups/"
  }
}
