{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Quartz": {
    "SyncCron": "0 0 2 * * ?",
    "InboxCron": "0 0 */6 * * ?",
    "CategorizationCron": "0 30 2 * * ?",
    "OrganizeCron": "0 */15 * * * ?",
    "CleanupCron": "0 0 3 * * ?",
    "BackupCron": "0 0 4 * * ?"
  },
  "Categorization": {
    "AutoFileConfidence": 0.65,
    "KeywordThreshold": 0.7,
    "TfIdfThreshold": 0.5,
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "mistral"
  },
  "Organize": {
    "ExecutionBatchSize": 20,
    "DailyMoveBudget": 80
  },
  "Backup": {
    "Directory": "./data/backups/"
  }
}
