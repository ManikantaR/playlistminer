# Required
POSTGRES_PASSWORD=changeme_in_production
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional overrides (defaults shown)
# NOTE: API_PORT is 5050 because macOS AirPlay Receiver occupies 5000.
# NEXT_PUBLIC_API_URL is baked into the web bundle at BUILD time (not runtime),
# so it must match API_PORT before `podman-compose up --build pm-web`.
POSTGRES_USER=playlistminer
API_PORT=5050
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:5050

# YouTube OAuth (required for playlist sync and video moves)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# AES-256 encryption key for storing OAuth refresh tokens in the database.
# Generate with: openssl rand -base64 32
YOUTUBE_ENCRYPTION_KEY=

# Ollama (optional, enable with: podman-compose --profile ai up)
# Phase 1 default per docs/VISION-v2.md §4 — Qwen ~8B (Q4) fits fully in 16GB M1 memory.
# Verify the exact tag with `ollama list` / the Ollama library before pulling.
OLLAMA_MODEL=qwen2.5:7b

# ── NAS deployment only (docker-compose.nas.yml) ───────────────────────────────
# On the NAS, the web bundle must point at the real HTTPS domain (host root, no /api):
# NEXT_PUBLIC_API_URL=https://playlistminer.home.manikantar.com
#
# Inference runs on the Mac, so the NAS worker must reach the Mac's Ollama over the LAN.
# Set Ollama to listen on all interfaces on the Mac first:
#   launchctl setenv OLLAMA_HOST 0.0.0.0  (then restart Ollama)
# Then point the worker at the Mac's LAN IP (10.140.1.x on MyHome VLAN):
# MAC_OLLAMA_URL=http://10.140.1.50:11434

# Backup (defaults to ./data/backups/)
# BACKUP_DIRECTORY=./data/backups/
