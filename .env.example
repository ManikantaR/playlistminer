# Required
POSTGRES_PASSWORD=changeme_in_production
YOUTUBE_API_KEY=your_youtube_api_key_here

# Optional overrides (defaults shown)
POSTGRES_USER=playlistminer
API_PORT=5000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# YouTube OAuth (required for playlist sync and video moves)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# AES-256 encryption key for storing OAuth refresh tokens in the database.
# Generate with: openssl rand -base64 32
YOUTUBE_ENCRYPTION_KEY=

# Ollama (optional, enable with: podman-compose --profile ai up)
OLLAMA_MODEL=mistral

# Backup (defaults to ./data/backups/)
# BACKUP_DIRECTORY=./data/backups/
