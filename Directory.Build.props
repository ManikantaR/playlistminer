<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <RootNamespace>$(MSBuildProjectName.Replace("-", "_"))</RootNamespace>
  </PropertyGroup>

  <!-- Force MessagePack to patched version to resolve known CVEs pulled in transitively by Aspire.
       Aspire 13.x pulls MessagePack 2.5.192 which has multiple known vulnerabilities.
       Override to 3.1.7 which resolves all known CVEs as of June 2026. -->
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.7" />
  </ItemGroup>
</Project>
